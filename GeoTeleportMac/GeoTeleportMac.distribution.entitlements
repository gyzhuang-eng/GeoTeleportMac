<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- No App Sandbox: app spawns child processes and accesses USB via IOKit/CoreDevice -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- get-task-allow must be absent/false for Developer ID distribution -->
</dict>
</plist>
